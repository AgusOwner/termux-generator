+package com.termux.app;
+
+/** Values replaced at build time by termux-generator (see patch_apps). None of them is a secret. */
+final class KeyAuthConfig {
+    static final String API_URL = "https://keyauth.win/api/1.2/";
+    static final String NAME = "@KEYAUTH_NAME@";
+    static final String OWNER_ID = "@KEYAUTH_OWNERID@";
+    static final String VERSION = "@KEYAUTH_VERSION@";
+
+    private KeyAuthConfig() {}
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/LicenseActivity.java b/termux-app/app/src/main/java/com/termux/app/LicenseActivity.java
