diff --git a/termux-app/app/src/main/java/com/termux/app/KeyAuthClient.java b/termux-app/app/src/main/java/com/termux/app/KeyAuthClient.java
new file mode 100644
index 0000000..ed2d63b
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/app/KeyAuthClient.java
@@ -0,0 +1,88 @@
+package com.termux.app;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+
+/** Minimal KeyAuth (API 1.2) client: init + license. Blocking, call it from a background thread. */
+final class KeyAuthClient {
+
+    static final class Result {
+        final boolean ok;
+        final String message;
+
+        Result(boolean ok, String message) {
+            this.ok = ok;
+            this.message = message;
+        }
+    }
+
+    private KeyAuthClient() {}
+
+    static Result checkLicense(Context context, String key) {
+        try {
+            JSONObject init = new JSONObject(post(
+                "type=init"
+                    + "&ver=" + enc(KeyAuthConfig.VERSION)
+                    + "&name=" + enc(KeyAuthConfig.NAME)
+                    + "&ownerid=" + enc(KeyAuthConfig.OWNER_ID)));
+            if (!init.optBoolean("success", false)) {
+                return new Result(false, init.optString("message", "No se pudo iniciar la validacion"));
+            }
+            String sessionId = init.getString("sessionid");
+
+            String hwid = Settings.Secure.getString(context.getContentResolver(), Settings.Secure.ANDROID_ID);
+            if (hwid == null) hwid = "unknown";
+
+            JSONObject lic = new JSONObject(post(
+                "type=license"
+                    + "&key=" + enc(key)
+                    + "&hwid=" + enc(hwid)
+                    + "&sessionid=" + enc(sessionId)
+                    + "&name=" + enc(KeyAuthConfig.NAME)
+                    + "&ownerid=" + enc(KeyAuthConfig.OWNER_ID)));
+            if (lic.optBoolean("success", false)) {
+                return new Result(true, "OK");
+            }
+            return new Result(false, lic.optString("message", "Key invalida"));
+        } catch (Exception e) {
+            return new Result(false, "Sin conexion o respuesta invalida");
+        }
+    }
+
+    private static String enc(String value) throws Exception {
+        return URLEncoder.encode(value, "UTF-8");
+    }
+
+    private static String post(String body) throws Exception {
+        HttpURLConnection conn = (HttpURLConnection) new URL(KeyAuthConfig.API_URL).openConnection();
+        try {
+            conn.setRequestMethod("POST");
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(15000);
+            conn.setDoOutput(true);
+            conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+            try (OutputStream out = conn.getOutputStream()) {
+                out.write(body.getBytes(StandardCharsets.UTF_8));
+            }
+            InputStream in = conn.getResponseCode() >= 400 ? conn.getErrorStream() : conn.getInputStream();
+            if (in == null) throw new Exception("empty response");
+            ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+            byte[] chunk = new byte[4096];
+            int read;
+            while ((read = in.read(chunk)) != -1) buffer.write(chunk, 0, read);
+            return buffer.toString("UTF-8");
+        } finally {
+            conn.disconnect();
+        }
+    }
+}
